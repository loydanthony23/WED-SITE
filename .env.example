# Copy this file to .env and fill in your values.

# The deployed Google Apps Script Web App URL for the RSVP form (ends in /exec).
# See google-apps-script/README.md for how to get this.
VITE_RSVP_ENDPOINT=

# The deployed Web App URL for Shared Moments photo uploads (ends in /exec).
# See google-apps-script/uploads/README.md for how to get this.
VITE_UPLOAD_ENDPOINT=
